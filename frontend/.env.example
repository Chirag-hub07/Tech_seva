# URL of the FastAPI server. The frontend never connects directly to PostgreSQL/Supabase.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Set to true to explore every screen with fictional test records. Never use this for real monitoring.
VITE_DEMO_MODE=false
# Supabase project settings. Authentication requires these values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
